ARG FROM_VERSION
# This image is the base for the release/build chain (dev-r-base -> dev-r-4.5.2 ->
# dev-build-base -> dev-build-hadoop), which builds the docs via make-dist.sh ->
# sphinx-build. The pinned sphinx==3.0.4 cannot run on Python >=3.13 (epub3 builder
# imports imghdr, removed from the stdlib in 3.13), so this single bundled env must be
# the newest Python that still has imghdr. Keep in sync with Jenkinsfile-Release's
# env.PYTHON_VERSION. Bump back to 3.14 once docs-requirements.txt is modernized.
FROM 353750902984.dkr.ecr.us-east-1.amazonaws.com/h2o-3/dev-python-3.12:${FROM_VERSION}

# Prepare packages to be able to build R from sources
RUN \
    sed -i.bak "/^#.*deb-src.*universe$/s/^# //g" /etc/apt/sources.list && \
    apt-get update && \
    mkdir -p /usr/share/man/man1 && \
    DEBIAN_FRONTEND=noninteractive apt -y build-dep r-base

# For rgl R package
RUN \
    apt-get install -y zip libglu1-mesa-dev libpcre2-dev libpng-dev libtiff5-dev libjpeg-dev libwebp-dev

# Remove unnecessary packages
RUN \
    apt-get -y remove openjdk-8-jdk openjdk-8-jdk-headless openjdk-8-jre openjdk-8-jre-headless && \
    apt-get clean && \
    apt-get autoremove -y && \
    rm -rf /var/cache/apt/*

# Install pandoc
RUN \
    wget https://github.com/jgm/pandoc/releases/download/2.1.1/pandoc-2.1.1-linux.tar.gz && \
    tar -xvzf pandoc-2.1.1-linux.tar.gz --strip-components 1 -C /usr/local/ && \
    rm -rf pandoc-2.1.1-linux.tar.gz

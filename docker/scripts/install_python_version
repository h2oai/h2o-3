#!/bin/bash -ex
set -uo pipefail

# Script for installing all Py versions specified as comma separated list
# in ${1} or in ${PYTHON_VERSIONS}.

if [[ -z "${H2O_BRANCH:-}" ]]; then
	echo "H2O_BRANCH must be set"
	exit 1
fi

VERSIONS_TO_INSTALL="${1:-}"
if [[ -z "${VERSIONS_TO_INSTALL}" ]]; then
	VERSIONS_TO_INSTALL="${PYTHON_VERSIONS:-}"
fi
if [[ -z "${VERSIONS_TO_INSTALL}" ]]; then
	echo "Either PYTHON_VERSIONS must be set or provide and argument containing required versions"
	exit 1
fi

# Download requirements files from GitHub. `wget` already exits non-zero on
# HTTP errors thanks to `set -e`, but a quick post-check makes a corrupted /
# empty download fail loudly here rather than at install time where the error
# would surface as a confusing "no candidates" message.
wget -nv "https://raw.githubusercontent.com/h2oai/h2o-3/${H2O_BRANCH}/h2o-py/test-requirements.txt"
wget -nv "https://raw.githubusercontent.com/h2oai/h2o-3/${H2O_BRANCH}/h2o-py/docs-requirements.txt"
[[ -s test-requirements.txt ]] || { echo "ERROR: test-requirements.txt is empty after wget"; exit 1; }
[[ -s docs-requirements.txt ]] || { echo "ERROR: docs-requirements.txt is empty after wget"; exit 1; }

IFS=',' read -r -a array <<<${VERSIONS_TO_INSTALL}
for python_version in "${array[@]}"; do
	echo "###### Installing Python ${python_version} ######"
	if [[ "${python_version}" =~ ^([0-9])\.([0-9]+).* ]]; then
		major=${BASH_REMATCH[1]}
		minor=${BASH_REMATCH[2]}
	else
		echo "Invalid Python version: ${python_version}"
		exit 1
	fi
	if [[ ${major} == "2" ]]; then pkg_suffix=""; else pkg_suffix=${major}; fi

	apt-get update
	if [[ ${python_version} == "3.6" ]]; then
		DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential checkinstall libreadline-dev libncursesw5-dev libssl-dev libsqlite3-dev tk-dev libgdbm-dev libc6-dev libbz2-dev clang
		pushd /usr/src
		wget -nv https://www.python.org/ftp/python/3.6.15/Python-3.6.15.tar.xz
		echo "bc04aa6c2a1a172a35012abd668538cd Python-3.6.15.tar.xz" >Python-3.6.15.tar.xz.md5
		md5sum -c Python-3.6.15.tar.xz.md5 || exit 1 # unexpected checksum
		tar xf Python-3.6.15.tar.xz
		cd Python-3.6.15
		export CC="clang" # needed to avoid SegFault during install
		./configure
		make
		make install
		popd
	else
		DEBIAN_FRONTEND=noninteractive apt-get -y install python${python_version} python${python_version}-dev python${pkg_suffix}-setuptools
		if [[ ${major} -ge 3 && ${minor} -ge 7 && ${minor} -lt 12 ]]; then
			DEBIAN_FRONTEND=noninteractive apt-get -y install python${python_version}-distutils
		fi
	fi
	apt-get clean
	rm -rf /var/cache/apt/*

	echo "###### Installing pip for Python ${python_version} ######"
	curl -f https://bootstrap.pypa.io/pip/${python_version}/get-pip.py --output get-pip.py || curl https://bootstrap.pypa.io/get-pip.py --output get-pip.py
	python${python_version} get-pip.py

	echo "###### Creating Virtualenv for Python ${python_version} ######"
	python${python_version} -m pip install virtualenv
	mkdir -p /envs/h2o_env_python${python_version}
	chmod a+w -R /envs/h2o_env_python${python_version}
	su jenkins -c "virtualenv -p python${python_version} /envs/h2o_env_python${python_version}"

	echo "###### Installing dependencies for Python ${python_version} ######"
	su jenkins -c ". /envs/h2o_env_python${python_version}/bin/activate && pip uninstall setuptools -y && pip install setuptools" # resinstalling setuptools fixes install issues for sphinx-osexample

	# causalml's legacy setup.py runs cythonize() at metadata time and cimports
	# sklearn.tree._criterion, which is invisible inside pip's isolated build env.
	# Install everything else first (populating cython + scikit-learn into the venv),
	# then install causalml with --no-build-isolation so it sees them.
	#
	# Step 2 uses a `pip freeze` snapshot of step 1 as the constraint file rather
	# than the requirements files. Constraint files only pin packages they
	# literally name -- so passing the requirements files alone leaves causalml's
	# transitive deps (e.g. torch, pyro-ppl) free to upgrade things like scipy
	# 1.10.1 -> 1.15.3, which removes `trapz` and breaks lifelines. Freezing the
	# whole resolved set after step 1 pins every transitive package as well.
	#
	# Detect whether `causalml` actually appears in test-requirements.txt for this
	# Python version; if not, skip step 2 entirely instead of running pip with an
	# empty -r argument (which would either no-op silently or error out).
	grep -v '^causalml' test-requirements.txt > test-requirements-no-causalml.txt
	if grep -q '^causalml' test-requirements.txt; then
		grep '^causalml' test-requirements.txt > causalml-requirements.txt
		HAVE_CAUSALML=1
	else
		HAVE_CAUSALML=0
		echo "###### No causalml pin for Python ${python_version} -- skipping step-2 install ######"
	fi
	su jenkins -c ". /envs/h2o_env_python${python_version}/bin/activate && \
		pip install -r test-requirements-no-causalml.txt -r docs-requirements.txt && \
		pip freeze > /tmp/step1-frozen-${python_version}.txt"
	if [[ "${HAVE_CAUSALML}" == "1" ]]; then
		su jenkins -c ". /envs/h2o_env_python${python_version}/bin/activate && \
			pip install --no-build-isolation \
				-c /tmp/step1-frozen-${python_version}.txt \
				-r causalml-requirements.txt"
	fi
	rm -f /tmp/step1-frozen-${python_version}.txt

	su jenkins -c "mkdir -p ~/.config/matplotlib/ && echo "backend: Agg" > ~/.config/matplotlib/matplotlibrc"
	echo "###### Show all packages installed for Python ${python_version} ######"
	su jenkins -c ". /envs/h2o_env_python${python_version}/bin/activate && pip freeze"
done

rm *-requirements*.txt
